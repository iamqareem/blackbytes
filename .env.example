# App
PORT=3000
ADMIN_PORT=3001
NODE_ENV=development
SITE_URL=http://localhost:3000

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Auth
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# Caddy / Admin Domain
CADDY_ADMIN_DOMAIN=admin.gossip.ugaplex.com

# Google Ads / Analytics
GA4_ID=G-XXXXXXXXXX
ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT_FEED=1234567890
ADSENSE_SLOT_SIDEBAR=0987654321

# Scraper
SCRAPER_CRON=*/30 * * * *
SCRAPER_USER_AGENT=Snapfeed/1.0 (+https://gossip.ugaplex.com)

# Turso (remote SQLite for PWA)
# Set these after creating a Turso database: turso db create snapfeed
# Your instance: libsql://snapfeed-mwanja.aws-ap-south-1.turso.io
TURSO_URL=libsql://snapfeed-mwanja.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# Absolute path to yt-dlp binary (TikTok channel fetching). Defaults to ~/.local/bin/yt-dlp
# YT_DLP_PATH=/home/you/.local/bin/yt-dlp